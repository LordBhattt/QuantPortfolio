# Copy this file to backend/.env (or a root-level .env) and adjust as needed.
# Nothing here is required to start the app -- every setting has a working
# default (see backend/config.py) and DATABASE_URL falls back to a local
# SQLite file automatically if it can't connect. Fill in real values when
# you want to run against your own Postgres/Redis instead of the fallbacks.

# App
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEBUG=false

# Auth cookie
AUTH_COOKIE_NAME=qp_access_token
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false

# CORS -- frontend origins allowed to call this API
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8080","http://127.0.0.1:5173","http://127.0.0.1:8080"]

# Database (async SQLAlchemy URL). Falls back to a local SQLite file if
# unreachable at startup -- see the "Zero-dependency quickstart" in README.md.
DATABASE_URL=postgresql+asyncpg://quantportfolio:quantportfolio@localhost:5432/quantportfolio
# DIRECT_URL: only needed for Supabase (pooled connections can't run DDL for
# migrations). Omit entirely for a plain local/Docker Postgres.
# DIRECT_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

# Redis. Falls back to an in-memory cache automatically if unreachable.
REDIS_URL=redis://localhost:6379

# External market data APIs (all free-tier, no signup required for the
# defaults below; ALPHA_VANTAGE_KEY is currently unused by the app).
ALPHA_VANTAGE_KEY=demo
COINGECKO_BASE=https://api.coingecko.com/api/v3
YAHOO_BASE=https://query1.finance.yahoo.com/v8/finance
AMFI_NAV_URL=https://www.amfiindia.com/spages/NAVAll.txt
PRICE_HISTORY_TTL_SECONDS=3600
LIVE_QUOTE_TTL_SECONDS=60

# Quant engine parameters
RISK_FREE_RATE=0.065
MVO_ROLLING_WINDOW_DAYS=252
HMM_N_STATES=3
MONTE_CARLO_PATHS=1000
MONTE_CARLO_HORIZON_DAYS=252
CVAR_CONFIDENCE=0.95
