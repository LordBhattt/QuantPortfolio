# ============================================================
# QuantPortfolio - backend environment example
# Copy to backend/.env and fill in real values.
# DO NOT commit backend/.env to version control.
# ============================================================

# --- App ---
# Generate with: python backend/scripts/generate_secret.py
# Paste the generated value below. APP_ENV=development may be used for local
# development when no persistent secret is configured.
APP_ENV=development
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEBUG=false
AUTH_COOKIE_NAME=qp_access_token
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false

# --- Database ---
DATABASE_URL=postgresql+asyncpg://quantportfolio:quantportfolio@localhost:5432/quantportfolio

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- External APIs ---
ALPHA_VANTAGE_KEY=your-alpha-vantage-key-here
COINGECKO_BASE=https://api.coingecko.com/api/v3
YAHOO_BASE=https://query1.finance.yahoo.com/v8/finance
AMFI_NAV_URL=https://www.amfiindia.com/spages/NAVAll.txt
PRICE_HISTORY_TTL_SECONDS=3600
LIVE_QUOTE_TTL_SECONDS=60

# --- ML ---
LSTM_WEIGHTS_PATH=ml/weights/lstm_latest.pt
LSTM_LOOKBACK_DAYS=60
LSTM_FORECAST_DAYS=30

# --- Quant params ---
RISK_FREE_RATE=0.065
MVO_ROLLING_WINDOW_DAYS=252
HMM_N_STATES=3
MONTE_CARLO_PATHS=1000
MONTE_CARLO_HORIZON_DAYS=252
CVAR_CONFIDENCE=0.95

# --- New settings ---
EXPECTED_RETURN_FLOOR_ENABLED=true
ML_FORECASTER_VERSION=gbm
BACKTEST_CACHE_TTL_SECONDS=3600
